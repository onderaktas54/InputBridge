<Window x:Class="InputBridge.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InputBridge · Windows Host"
        Width="920" Height="650" MinWidth="820" MinHeight="590"
        Style="{StaticResource DefaultWindowStyle}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource BrushHeader}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="26,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="52" Height="52" CornerRadius="14"
                        Background="{StaticResource BrushBrandGradient}">
                    <TextBlock Text="⌁" FontSize="34" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="InputBridge" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource BrushText}" />
                    <TextBlock Text="WINDOWS HOST · SECURE NETWORK KVM"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushPrimary}" />
                </StackPanel>

                <Border Grid.Column="3" CornerRadius="14" Padding="13,7"
                        Background="#112B2A" BorderBrush="#1F6B60"
                        BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock Text="●  AES-256-GCM" Foreground="#6EE7C7"
                               FontSize="11" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="26,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="DURUM" Style="{StaticResource SectionLabelStyle}"
                                   Margin="0,0,0,14" />
                        <TextBlock x:Name="TxtStatus"
                                   Text="🔴 Bağlantı bekleniyor"
                                   Foreground="{StaticResource BrushError}"
                                   FontWeight="SemiBold" FontSize="21" />
                        <TextBlock x:Name="TxtDetails"
                                   Text="Gecikme: -- ms · Mod: BU BİLGİSAYAR"
                                   Foreground="{StaticResource BrushTextDim}"
                                   FontSize="13" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="KONTROL HEDEFİ"
                                   Style="{StaticResource SectionLabelStyle}"
                                   Margin="0,0,0,14" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnLocalMode"
                                    Grid.Column="0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="116" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="⌂" FontSize="26"
                                               Foreground="{StaticResource BrushPrimary}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Bu bilgisayar" FontWeight="SemiBold"
                                               FontSize="15" HorizontalAlignment="Center"
                                               Margin="0,5,0,0" />
                                    <TextBlock x:Name="TxtLocalHotkeyDisplay"
                                               Text="Ctrl+Win+1" FontSize="12"
                                               Foreground="{StaticResource BrushTextDim}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TxtLocalActive"
                                               Text="● AKTİF" FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushSuccess}"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnRemoteMode"
                                    Grid.Column="2"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="116" Padding="16" IsEnabled="False">
                                <StackPanel>
                                    <TextBlock Text="▣" FontSize="25"
                                               Foreground="{StaticResource BrushViolet}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Linux Client" FontWeight="SemiBold"
                                               FontSize="15" HorizontalAlignment="Center"
                                               Margin="0,5,0,0" />
                                    <TextBlock x:Name="TxtRemoteHotkeyDisplay"
                                               Text="Ctrl+Win+2" FontSize="12"
                                               Foreground="{StaticResource BrushTextDim}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TxtRemoteActive"
                                               Text="BAĞLANTI BEKLENİYOR" FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextDim}"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Background="#101B2D" CornerRadius="9"
                                Padding="13" Margin="0,14,0,0">
                            <TextBlock Text="Ctrl+Alt+Esc acil durumda tüm girişleri bırakır ve kontrolü bu bilgisayara döndürür."
                                       Foreground="{StaticResource BrushTextDim}"
                                       TextWrapping="Wrap" FontSize="12" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="BAĞLANTI AYARLARI"
                                   Style="{StaticResource SectionLabelStyle}"
                                   Margin="0,0,0,16" />

                        <TextBlock Text="TCP PORT"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="TxtTcpPort" Text="7201"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Margin="0,0,0,14" />

                        <TextBlock Text="SECRET KEY"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <PasswordBox x:Name="TxtSecret"
                                     Style="{StaticResource InputPasswordBoxStyle}"
                                     Margin="0,0,0,18" />

                        <Button x:Name="BtnConnect"
                                Content="Host'u başlat"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="BtnConnect_Click"
                                Margin="0,0,0,10" />
                        <Button x:Name="BtnSettings"
                                Content="Kısayol ayarları"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnSettings_Click"
                                Margin="0,0,0,10" />
                        <Button x:Name="BtnExit"
                                Content="Uygulamadan çık"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="BtnExit_Click" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="HIZLI BAŞLANGIÇ"
                                   Style="{StaticResource SectionLabelStyle}"
                                   Margin="0,0,0,12" />
                        <TextBlock Foreground="{StaticResource BrushTextDim}"
                                   FontSize="12" TextWrapping="Wrap"
                                   LineHeight="20">
                            <Run Text="1. Linux Client ile aynı Secret Key'i gir." />
                            <LineBreak />
                            <Run Text="2. Host'u başlat ve özel ağ firewall iznini ver." />
                            <LineBreak />
                            <Run Text="3. Bağlanınca Ctrl+Win+2 ile Linux'a geç." />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource BrushHeader}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,1,0,0"
                Padding="26,13">
            <Grid>
                <TextBlock Text="●  TCP 7201 · UDP 7200 · LAN discovery 7202"
                           Foreground="{StaticResource BrushTextDim}"
                           FontSize="11" />
                <TextBlock Text="InputBridge Windows · Host"
                           Foreground="{StaticResource BrushTextDim}"
                           FontSize="11" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
